          "customCss": ":root {\n\n  /* Typography */\n  --font-family: 'Inter', 'Segoe UI', sans-serif;\n\n  --font-weight-normal: 400;\n  --font-weight-medium: 500;\n  --font-weight-bold: 600;\n\n  --font-size-body: 14px;\n  --font-size-label: 14px;\n  --font-size-input: 15px;\n  --font-size-header: 28px;\n  --font-size-subheader: 16px;\n  --font-size-link: 13px;\n  --font-size-error: 12px;\n\n  --font-size-html-h1: 36px;\n  --font-size-html-h2: 28px;\n  --font-size-html-h3: 22px;\n  --font-size-html-h4: 18px;\n  --font-size-html-h5: 16px;\n  --font-size-html-h6: 14px;\n\n  /* Colors */\n  --color-background: #0f172a;\n  --color-surface: rgba(15, 23, 42, 0.7);\n  --color-card-bg: rgba(17, 25, 40, 0.75);\n\n  --color-card-border: rgba(255, 255, 255, 0.08);\n  --color-card-shadow: rgba(0, 0, 0, 0.35);\n\n  --color-header: #f8fafc;\n  --color-header-subtext: #94a3b8;\n\n  --color-label: #cbd5e1;\n\n  --color-input-bg: rgba(255, 255, 255, 0.04);\n  --color-input-border: rgba(255, 255, 255, 0.08);\n  --color-input-text: #f1f5f9;\n  --color-placeholder: rgba(241, 245, 249, 0.45);\n\n  --color-focus-border: #10a37f;\n  --color-focus-shadow: rgba(16, 163, 127, 0.35);\n\n  --color-submit-btn-bg: #10a37f;\n  --color-submit-btn-hover: #0d8c6d;\n  --color-submit-btn-text: #ffffff;\n\n  --color-link: #10a37f;\n\n  --color-error: #ef4444;\n  --color-required: #ef4444;\n\n  --color-clear-button-bg: #334155;\n\n  --color-html-text: #e2e8f0;\n  --color-html-link: #10a37f;\n\n  /* Border Radius */\n  --border-radius-card: 20px;\n  --border-radius-input: 14px;\n  --border-radius-button: 14px;\n  --border-radius-clear-btn: 50%;\n\n  /* Spacing */\n  --padding-container-top: 40px;\n\n  --padding-card: 32px;\n\n  --padding-form-input: 14px 16px;\n\n  --margin-bottom-card: 24px;\n\n  /* Dimensions */\n  --container-width: 460px;\n\n  --submit-btn-height: 52px;\n\n  --checkbox-size: 18px;\n\n  /* Effects */\n  --backdrop-blur: blur(18px);\n\n  --box-shadow-card:\n    0 8px 32px rgba(0, 0, 0, 0.35);\n\n  --transition-speed: 0.25s ease;\n}\n\n\n/* GLOBAL BODY */\n\nbody {\n  margin: 0;\n  padding: 0;\n  font-family: var(--font-family);\n  background:\n    radial-gradient(circle at top left, #1e293b 0%, #0f172a 40%),\n    radial-gradient(circle at bottom right, #111827 0%, #020617 60%);\n  min-height: 100vh;\n  color: var(--color-html-text);\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n\n/* CARD */\n\n.card {\n  width: 100%;\n  max-width: var(--container-width);\n\n  background: var(--color-card-bg);\n\n  border: 1px solid var(--color-card-border);\n\n  backdrop-filter: var(--backdrop-blur);\n\n  border-radius: var(--border-radius-card);\n\n  box-shadow: var(--box-shadow-card);\n\n  padding: var(--padding-card);\n\n  transition: transform var(--transition-speed);\n}\n\n.card:hover {\n  transform: translateY(-2px);\n}\n\n\n/* HEADER */\n\n.card h1 {\n  margin: 0 0 10px;\n  font-size: var(--font-size-header);\n  font-weight: var(--font-weight-bold);\n  color: var(--color-header);\n}\n\n.card p {\n  margin: 0 0 24px;\n  color: var(--color-header-subtext);\n  font-size: var(--font-size-subheader);\n  line-height: 1.6;\n}\n\n\n/* LABEL */\n\nlabel {\n  display: block;\n  margin-bottom: 8px;\n\n  font-size: var(--font-size-label);\n\n  font-weight: var(--font-weight-medium);\n\n  color: var(--color-label);\n}\n\n\n/* INPUT */\n\ninput,\ntextarea,\nselect {\n  width: 100%;\n\n  padding: var(--padding-form-input);\n\n  background: var(--color-input-bg);\n\n  border: 1px solid var(--color-input-border);\n\n  border-radius: var(--border-radius-input);\n\n  color: var(--color-input-text);\n\n  font-size: var(--font-size-input);\n\n  outline: none;\n\n  transition:\n    border-color var(--transition-speed),\n    box-shadow var(--transition-speed),\n    background var(--transition-speed);\n\n  box-sizing: border-box;\n}\n\ninput::placeholder,\ntextarea::placeholder {\n  color: var(--color-placeholder);\n}\n\ninput:focus,\ntextarea:focus,\nselect:focus {\n  border-color: var(--color-focus-border);\n\n  box-shadow:\n    0 0 0 4px var(--color-focus-shadow);\n\n  background: rgba(255, 255, 255, 0.06);\n}\n\n\n/* BUTTON */\n\nbutton {\n  width: 100%;\n\n  height: var(--submit-btn-height);\n\n  border: none;\n\n  border-radius: var(--border-radius-button);\n\n  background: var(--color-submit-btn-bg);\n\n  color: var(--color-submit-btn-text);\n\n  font-size: 15px;\n\n  font-weight: var(--font-weight-bold);\n\n  cursor: pointer;\n\n  transition:\n    background var(--transition-speed),\n    transform var(--transition-speed),\n    box-shadow var(--transition-speed);\n\n  margin-top: 18px;\n}\n\nbutton:hover {\n  background: var(--color-submit-btn-hover);\n\n  transform: translateY(-1px);\n\n  box-shadow:\n    0 8px 20px rgba(16, 163, 127, 0.25);\n}\n\nbutton:active {\n  transform: scale(0.98);\n}\n\n\n/* LINKS */\n\na {\n  color: var(--color-link);\n  text-decoration: none;\n}\n\na:hover {\n  text-decoration: underline;\n}\n\n\n/* ERROR */\n\n.error {\n  color: var(--color-error);\n  font-size: var(--font-size-error);\n  margin-top: 6px;\n}\n\n\n/* RESPONSIVE */\n\n@media (max-width: 520px) {\n\n  .card {\n    margin: 16px;\n    padding: 24px;\n  }\n\n  .card h1 {\n    font-size: 24px;\n  }\n\n}"
